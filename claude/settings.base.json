      "Read(~/AppData/Local/Microsoft/Vault/**)",
      "Read(~/AppData/Roaming/Microsoft/Vault/**)",
      "Read(~/AppData/Roaming/GitHub CLI/**)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(~/.ssh/**)",
      "Edit(~/.aws/**)",
      "Edit(~/.gnupg/**)",
      "Edit(~/.azure/**)",
      "Edit(~/.kube/**)",
      "Edit(~/.docker/config.json)",
      "Edit(~/.pypirc)",
      "Edit(~/.config/gh/**)",
      "Edit(~/.config/glab-cli/**)",
      "Edit(~/.config/git/credentials)",
      "Edit(~/.git-credentials)",
      "Edit(~/.netrc)",
      "Edit(~/.npmrc)",
      "Edit(~/.claude/.credentials.json)",
      "Edit(~/.claude.json)",
      "Edit(~/.claude.json.backup*)",
      "Edit(~/.claude/backups/**)",
      "Edit(~/AppData/Local/Microsoft/Credentials/**)",
      "Edit(~/AppData/Roaming/Microsoft/Credentials/**)",
      "Edit(~/AppData/Roaming/Microsoft/Protect/**)",
      "Edit(~/AppData/Local/Microsoft/Vault/**)",
      "Edit(~/AppData/Roaming/Microsoft/Vault/**)",
      "Edit(~/AppData/Roaming/GitHub CLI/**)",
