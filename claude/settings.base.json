      "Bash(rm -rf / *)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/)",
      "Bash(rm -fr /)",
      "Bash(rm -fr / *)",
      "Bash(rm -fr ~)",
      "Bash(rm -fr ~/)",
      "Bash(npx --yes:*)",
