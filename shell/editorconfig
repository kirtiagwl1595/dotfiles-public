# Linked to ~/.editorconfig. Editors (VS Code, Sublime) use it in folders without their own.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

# Markdown: two trailing spaces are a line break (a comment after the value breaks it)
[*.md]
trim_trailing_whitespace = false

[{Makefile,*.mk,.gitconfig,config.shared,config.delta}]
indent_style = tab
